{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "./.github/hooks/scripts/log-hook-event.sh sessionStart",
        "powershell": "./.github/hooks/scripts/log-hook-event.ps1 -HookName sessionStart",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "./.github/hooks/scripts/log-hook-event.sh preToolUse",
        "powershell": "./.github/hooks/scripts/log-hook-event.ps1 -HookName preToolUse",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "./.github/hooks/scripts/log-hook-event.sh postToolUse",
        "powershell": "./.github/hooks/scripts/log-hook-event.ps1 -HookName postToolUse",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "./.github/hooks/scripts/log-hook-event.sh sessionEnd",
        "powershell": "./.github/hooks/scripts/log-hook-event.ps1 -HookName sessionEnd",
        "cwd": ".",
        "timeoutSec": 5
      }
    ]
  }
}
